# ==============================================================================
# Security Hardening & Headers Configuration
# ==============================================================================

# 1. Disable Directory Browsing / Indexing
Options -Indexes

# 2. Block Access to Hidden Files & Sensitive Folders (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. HTTP Security Headers (OWASP Recommended)
<IfModule mod_headers.c>
    # Prevent Clickjacking (disallow embedding in foreign iframes)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Cross-Site Scripting (XSS) Filter Shield
    Header always set X-XSS-Protection "1; mode=block"

    # Referrer Policy to protect confidential URL data
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (Restrict unauthorized device hardware access)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self';"
</IfModule>

# 4. Gzip Compression for Performance & Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
